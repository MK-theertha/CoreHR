# ---------------------------------------------------------------------------
# Alarm notifications
# ---------------------------------------------------------------------------

resource "aws_sns_topic" "alarms" {
  name = "${var.project_name}-alarms"
}

resource "aws_sns_topic_subscription" "alarms_email" {
  count     = var.alarm_email != "" ? 1 : 0
  topic_arn = aws_sns_topic.alarms.arn
  protocol  = "email"
  endpoint  = var.alarm_email
}

# ---------------------------------------------------------------------------
# App runtime secrets — generated by Terraform, stored in SSM, fetched by the
# instance itself at deploy time (see templates/user_data.sh.tpl). They never
# appear in a docker image, a git repo, or plaintext user data.
# ---------------------------------------------------------------------------

resource "random_password" "jwt_access_secret" {
  length  = 48
  special = false
}

resource "random_password" "jwt_refresh_secret" {
  length  = 48
  special = false
}

resource "aws_ssm_parameter" "jwt_access_secret" {
  name  = "/${var.project_name}/${var.environment}/jwt_access_secret"
  type  = "SecureString"
  value = random_password.jwt_access_secret.result

  tags = { Name = "${var.project_name}-jwt-access-secret" }
}

resource "aws_ssm_parameter" "jwt_refresh_secret" {
  name  = "/${var.project_name}/${var.environment}/jwt_refresh_secret"
  type  = "SecureString"
  value = random_password.jwt_refresh_secret.result

  tags = { Name = "${var.project_name}-jwt-refresh-secret" }
}

# ---------------------------------------------------------------------------
# Application logs
# ---------------------------------------------------------------------------

resource "aws_cloudwatch_log_group" "app" {
  name              = "/${var.project_name}/${var.environment}/app"
  retention_in_days = 14

  tags = { Name = "${var.project_name}-app-logs" }
}

# ---------------------------------------------------------------------------
# EC2 app servers (Auto Scaling Group, fixed size — bump asg_desired_capacity
# or add a scaling policy later for real elasticity)
# ---------------------------------------------------------------------------

data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

locals {
  user_data = templatefile("${path.module}/templates/user_data.sh.tpl", {
    aws_region                  = var.aws_region
    project_name                = var.project_name
    environment                 = var.environment
    ecr_repository_url          = aws_ecr_repository.backend.repository_url
    image_tag                   = var.image_tag
    app_port                    = var.app_port
    db_host                     = aws_db_instance.postgres.address
    db_port                     = aws_db_instance.postgres.port
    db_name                     = var.db_name
    db_username                 = var.db_username
    ssm_db_password_name        = aws_ssm_parameter.db_password.name
    ssm_jwt_access_secret_name  = aws_ssm_parameter.jwt_access_secret.name
    ssm_jwt_refresh_secret_name = aws_ssm_parameter.jwt_refresh_secret.name
    jwt_access_ttl              = var.jwt_access_ttl
    jwt_refresh_ttl             = var.jwt_refresh_ttl
    client_url                  = var.client_url
    redis_host                  = aws_elasticache_replication_group.redis.primary_endpoint_address
    redis_port                  = 6379
    uploads_bucket              = aws_s3_bucket.uploads.id
    log_group_name              = aws_cloudwatch_log_group.app.name
  })
}

resource "aws_launch_template" "app" {
  name_prefix   = "${var.project_name}-app-"
  image_id      = data.aws_ami.al2023.id
  instance_type = var.ec2_instance_type

  iam_instance_profile {
    name = aws_iam_instance_profile.ec2.name
  }

  vpc_security_group_ids = [aws_security_group.ec2.id]

  # Instance Metadata Service v2 only — hardens against SSRF-style credential
  # theft (the classic "unauthenticated IMDSv1 call from inside a compromised
  # app" path).
  metadata_options {
    http_tokens   = "required"
    http_endpoint = "enabled"
  }

  block_device_mappings {
    device_name = "/dev/xvda"
    ebs {
      volume_size           = 20
      volume_type           = "gp3"
      encrypted             = true
      delete_on_termination = true
    }
  }

  user_data = base64encode(local.user_data)

  tag_specifications {
    resource_type = "instance"
    tags          = { Name = "${var.project_name}-app" }
  }

  tags = { Name = "${var.project_name}-app-lt" }
}

resource "aws_autoscaling_group" "app" {
  name                = "${var.project_name}-app-asg"
  vpc_zone_identifier = aws_subnet.private_app[*].id

  min_size         = var.asg_desired_capacity
  max_size         = var.asg_desired_capacity
  desired_capacity = var.asg_desired_capacity

  target_group_arns         = [aws_lb_target_group.app.arn]
  health_check_type         = "ELB"
  health_check_grace_period = 90

  launch_template {
    id      = aws_launch_template.app.id
    version = "$Latest"
  }

  tag {
    key                 = "Name"
    value               = "${var.project_name}-app"
    propagate_at_launch = true
  }
}

resource "aws_cloudwatch_metric_alarm" "ec2_cpu" {
  alarm_name          = "${var.project_name}-ec2-high-cpu"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 3
  metric_name         = "CPUUtilization"
  namespace           = "AWS/EC2"
  period              = 60
  statistic           = "Average"
  threshold           = 80
  alarm_description   = "App server CPU sustained above 80%."
  alarm_actions       = [aws_sns_topic.alarms.arn]

  dimensions = {
    AutoScalingGroupName = aws_autoscaling_group.app.name
  }
}

resource "aws_cloudwatch_metric_alarm" "ec2_memory" {
  alarm_name          = "${var.project_name}-ec2-high-memory"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 3
  metric_name         = "mem_used_percent"
  namespace           = "CWAgent"
  period              = 60
  statistic           = "Average"
  threshold           = 85
  alarm_description   = "App server memory usage above 85%."
  alarm_actions       = [aws_sns_topic.alarms.arn]

  dimensions = {
    AutoScalingGroupName = aws_autoscaling_group.app.name
  }
}

resource "aws_cloudwatch_metric_alarm" "ec2_disk" {
  alarm_name          = "${var.project_name}-ec2-high-disk"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 3
  metric_name         = "disk_used_percent"
  namespace           = "CWAgent"
  period              = 300
  statistic           = "Average"
  threshold           = 85
  alarm_description   = "App server root volume usage above 85%."
  alarm_actions       = [aws_sns_topic.alarms.arn]

  dimensions = {
    AutoScalingGroupName = aws_autoscaling_group.app.name
  }
}
