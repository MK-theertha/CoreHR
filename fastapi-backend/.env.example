APP_ENV=development
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/corehr
REDIS_URL=redis://localhost:6380/0

# Generate real random values for these two before ever setting APP_ENV=production —
# the app refuses to start in production with the insecure defaults below.
JWT_ACCESS_SECRET=corehr-access-secret-change-me
JWT_REFRESH_SECRET=corehr-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CLIENT_URL=http://localhost:5173,http://localhost:4173

# S3 (optional locally — leave S3_UPLOADS_BUCKET empty to disable profile
# image / document upload endpoints; they return 501 instead of erroring).
AWS_REGION=ap-south-1
S3_UPLOADS_BUCKET=
